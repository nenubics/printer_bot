#!/bin/sh /etc/rc.common
# Procd Init Script for Pantum BP2300NW Telegram Printer Bot on OpenWrt (Netis NX31 / Huawei AX3 / MIPS / ARM)

USE_PROCD=1
START=95
STOP=10

APP_DIR="/opt/printer_bot"
PYTHON_BIN="/opt/printer_bot/venv/bin/python3"
MAIN_SCRIPT="$APP_DIR/main.py"

start_service() {
    [ -f "$PYTHON_BIN" ] || {
        # Fallback to system python3 if venv not used
        PYTHON_BIN=$(which python3)
    }

    [ -f "$PYTHON_BIN" ] || {
        echo "[printer_bot] Error: Python 3 not found! Run opkg install python3"
        return 1
    }

    [ -f "$MAIN_SCRIPT" ] || {
        echo "[printer_bot] Error: Application not found at $MAIN_SCRIPT"
        return 1
    }

    # Защита флеш-памяти роутера: создаем спул в RAM tmpfs
    mkdir -p /tmp/printer_bot_spool
    chmod 700 /tmp/printer_bot_spool

    procd_open_instance
    procd_set_param command "$PYTHON_BIN" "$MAIN_SCRIPT"
    procd_set_param working_dir "$APP_DIR"
    
    # Автоматический перезапуск (respawn threshold 3600s, timeout 5s, max 5 retries)
    procd_set_param respawn 3600 5 5
    
    # Защита роутера: лимит виртуального адресного пространства (~180 МБ)
    # Предотвращает OOM для критических сервисов роутера (dnsmasq, hostapd, firewall4)
    procd_set_param limits as=188743680
    
    # Пониженный приоритет планировщика: роутинг трафика и Wi-Fi всегда важнее печати
    procd_set_param nice 10
    
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    echo "[printer_bot] Started with procd supervision (nice=10, spool in /tmp)."
}

stop_service() {
    echo "[printer_bot] Stopping service..."
}

reload_service() {
    stop
    start
}
