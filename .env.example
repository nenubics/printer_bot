# ==========================================
# Telegram Bot Token (получить у @BotFather)
# ==========================================
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ==========================================
# Telegram ID администраторов через запятую
# Узнать свой ID можно через бота @userinfobot
# ==========================================
ADMIN_IDS=123456789,987654321

# ==========================================
# Настройки принтера Pantum BP2300NW
# Режимы:
#   mock - симуляция для тестов (без реальной печати)
#   cups - печать через системный CUPS (рекомендуется для Linux/macOS)
#   raw  - прямая отправка на порт 9100 сетевого принтера
# ==========================================
PRINTER_MODE=mock
PRINTER_NAME=Pantum_BP2300NW
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100

# ==========================================
# Тарифы и лимиты
# ==========================================
PRICE_PER_PAGE_RUB=5.0
MAX_PAGES_PER_JOB=200
MAX_FILE_SIZE_BYTES=36700160

# ==========================================
# Реквизиты для оплаты по СБП (в ЦСО-4)
# ==========================================
SBP_PHONE=+7 (999) 000-00-00
SBP_BANK=Т-Банк / Сбербанк
SBP_RECIPIENT_NAME=Иван И.

# ==========================================
# Опционально: ЮKassa токен для карт
# ==========================================
YOOKASSA_PROVIDER_TOKEN=
